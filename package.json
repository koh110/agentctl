{
  "private": true,
  "type": "module",
  "name": "araya",
  "bin": {
    "araya": "./packages/araya/dist/bin/cli.js"
  },
  "workspaces": [
    "packages/araya"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "araya": "node packages/araya/bin/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "deploy": "PREFIX=\"${ARAYA_INSTALL_PREFIX:-${HOME:?set HOME or ARAYA_INSTALL_PREFIX}/.local}\" && npm run build && npm uninstall --global --prefix \"$PREFIX\" --no-audit --no-fund agentctl && npm install --global --prefix \"$PREFIX\" --no-audit --no-fund .",
    "test": "node --test packages/araya/test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "@earendil-works/chord": "1.1.0",
      "@earendil-works/pi-agent-core": "1.1.0",
      "@earendil-works/pi-ai": "1.1.0",
      "@earendil-works/pi-codemode": "1.1.0",
      "@earendil-works/pi-mcp": "1.1.0",
      "@earendil-works/pi-tui": "1.1.0"
    }
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  }
}
